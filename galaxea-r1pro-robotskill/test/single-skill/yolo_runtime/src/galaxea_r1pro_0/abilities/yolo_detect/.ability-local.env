# 备用真机 YOLO 入口使用当前能力仓库的真实配置。
# REPO_ROOT 由 bin/ability 定位，或通过 GALAXEA_ABILITY_ROOT 显式指定。
export ROBOT_PROFILE_PATH="$REPO_ROOT/src/galaxea_r1pro_0/config/r1pro-real-yolo.json"
export MODEL_REGISTRY_PATH="$REPO_ROOT/src/galaxea_r1pro_0/config/models.local.json"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
